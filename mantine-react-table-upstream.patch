+    }
+    return (
+      (minimum === undefined || rowValue.getTime() >= minimum) &&
+      (maximum === undefined || rowValue.getTime() <= maximum)
+    )
+  }
+
+  return (
+    (lower == null ||
+      lower === '' ||
+      greaterThanOrEqualTo(
+        row,
+        id,
+        lower instanceof Date ? lower.getTime() : lower,
+      )) &&
+    (upper == null ||
+      upper === '' ||
+      (lower != null && !isNaN(+lower) && !isNaN(+upper) && +lower > +upper) ||
+      lessThanOrEqualTo(
+        row,
+        id,
